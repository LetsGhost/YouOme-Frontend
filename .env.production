# Production build env (picked up automatically by `vite build`).
#
# JUDGMENT CALL: this is set to the site's own origin (with scheme) rather
# than an empty string. Empty string looks like the "obvious" same-origin
# value, but shared/api/backend.ts computes:
#   DEFAULT_API_BASE_URL = import.meta.env.VITE_API_BASE_URL || "http://localhost:3000"
# Since "" is falsy in JS, `VITE_API_BASE_URL=` would silently fall back to
# http://localhost:3000 at runtime, not to a same-origin relative path. Every
# API call is built as `${backendUrl}/api/...`, so setting this to the site's
# actual HTTPS origin produces the same same-origin /api/... requests (routed
# through the nginx reverse proxy in nginx/default.conf) without hitting that
# falsy-string fallback bug.
#
# REPLACE "YOUR_DOMAIN" with the real production domain (must match the
# domain used in backend/nginx/default.conf and the certbot certificate).
VITE_API_BASE_URL=https://YOUR_DOMAIN
VITE_APP_NAME=YouOme
